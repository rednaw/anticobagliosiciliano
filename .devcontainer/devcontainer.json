{
  "name": "anticobagliosiciliano",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "containerEnv": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "*"
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,readonly,consistency=cached",
    "source=${localEnv:HOME}/.cursor/skills,target=/home/node/.cursor/skills,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cursor/skills,target=/workspace/.cursor/skills,type=bind,consistency=cached"
  ],
  "postCreateCommand": "npm ci && npm ci --prefix archive/browser",
  "forwardPorts": [5173, 5174],
  "portsAttributes": {
    "5173": {
      "label": "Marketing site (Vite)",
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "Archivio (local only)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "editorconfig.editorconfig", "repreng.csv"],
      "settings": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false
      }
    }
  }
}
